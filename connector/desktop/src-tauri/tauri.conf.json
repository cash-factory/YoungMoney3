{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoungMoney3 Signal Desk",
  "version": "0.1.0",
  "identifier": "za.youngmoney3.signaldesk.staging",
  "build": { "frontendDist": "../desktop-ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "YoungMoney3 · Signal Desk Connector (Staging)",
      "width": 1450, "height": 900,
      "minWidth": 900, "minHeight": 640,
      "center": true, "resizable": true,
      "backgroundColor": "#f6f7f9"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ymfx-bridge"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}